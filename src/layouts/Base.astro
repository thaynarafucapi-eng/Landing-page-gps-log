---
import '../styles/global.css';
import { company, contact, tracking } from '../config/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.jpg', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#empresa', Astro.site).href,
  name: company.legalLabel,
  alternateName: company.name,
  slogan: company.slogan,
  description,
  url: new URL('/', Astro.site).href,
  logo: new URL('/brand/logo.svg', Astro.site).href,
  image: ogImage,
  telephone: '+55-92-99966-8377',
  foundingDate: String(company.foundingYear),
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${company.address.street}, ${company.address.district}`,
    addressLocality: company.address.city,
    addressRegion: company.address.state,
    addressCountry: company.address.country,
  },
  areaServed: [
    { '@type': 'City', name: 'Manaus' },
    { '@type': 'State', name: 'Amazonas' },
    { '@type': 'City', name: 'Boa Vista' },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '17:00',
    },
  ],
  sameAs: [contact.instagramUrl],
};

const { gtmId, ga4Id, googleAdsId, metaPixelId } = tracking;
const gtagId = ga4Id || googleAdsId;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#111111" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={company.legalLabel} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* ---------- Rastreamento: só carrega se o ID estiver configurado (.env / Netlify) ---------- */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
    </script>
    {
      gtmId && (
        <script is:inline define:vars={{ gtmId }}>
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s);
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', gtmId);
        </script>
      )
    }
    {
      gtagId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gtagId}`} />
          <script is:inline define:vars={{ ga4Id, googleAdsId }}>
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            gtag('js', new Date());
            if (ga4Id) gtag('config', ga4Id);
            if (googleAdsId) gtag('config', googleAdsId);
          </script>
        </>
      )
    }
    {
      metaPixelId && (
        <script is:inline define:vars={{ metaPixelId }}>
          !(function (f, b, e, v, n, t, s) {
            if (f.fbq) return;
            n = f.fbq = function () {
              n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
            };
            if (!f._fbq) f._fbq = n;
            n.push = n;
            n.loaded = !0;
            n.version = '2.0';
            n.queue = [];
            t = b.createElement(e);
            t.async = !0;
            t.src = v;
            s = b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t, s);
          })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', metaPixelId);
          fbq('track', 'PageView');
        </script>
      )
    }
  </head>
  <body>
    {
      gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
