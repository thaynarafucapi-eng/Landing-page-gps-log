---
import Photo from './Photo.astro';
import QuoteButton from './QuoteButton.astro';
import Icon from './Icon.astro';
import { photos } from '../config/photos';

const flow = [
  { icon: 'inbox', title: 'Recebimento', text: 'Conferência dos materiais na chegada.' },
  { icon: 'clipboard', title: 'Controle', text: 'Registro interno de entradas e saídas.' },
  { icon: 'boxes', title: 'Organização', text: 'Armazenagem identificada em porta-paletes.' },
  { icon: 'layers', title: 'Separação', text: 'Preparação dos itens de cada pedido.' },
  { icon: 'send', title: 'Expedição', text: 'Saída conforme a sua solicitação.' },
] as const;
---

<section class="section section--muted" id="armazenagem" aria-labelledby="armazenagem-title">
  <div class="container arm">
    <div class="arm__media">
      <Photo
        src={photos.armazenagem.src}
        alt={photos.armazenagem.alt}
        sizes="(max-width: 900px) 100vw, 540px"
        ratio="4 / 3"
        placeholderLabel={photos.armazenagem.pending}
      />
    </div>
    <div class="arm__copy">
      <p class="eyebrow">Armazenagem</p>
      <h2 id="armazenagem-title">Seus materiais guardados, controlados e prontos para sair</h2>
      <p class="lead">
        Recebemos e armazenamos mercadorias e materiais promocionais da sua empresa. A nossa equipe controla o estoque e
        separa e expede os itens quando você solicita, inclusive para as operações de positivação.
      </p>
      <ol class="flow">
        {
          flow.map((f) => (
            <li>
              <span class="flow__icon">
                <Icon name={f.icon} size={20} />
              </span>
              <div>
                <strong>{f.title}</strong>
                <span>{f.text}</span>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="arm__note">
        O controle de estoque é feito pela nossa equipe. Para saber a posição dos seus materiais, basta solicitar ao
        nosso atendimento.
      </p>
      <QuoteButton service="armazenagem" label="Solicitar orçamento de armazenagem" location="armazenagem" />
    </div>
  </div>
</section>

<style>
  .arm {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .flow {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 1.25rem;
    display: grid;
    gap: 0.25rem;
  }
  .flow li {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--gray-200);
  }
  .flow__icon {
    flex: none;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--gray-300);
    color: var(--red);
  }
  .flow strong {
    display: block;
    color: var(--ink);
    line-height: 1.3;
  }
  .flow span {
    font-size: 0.9375rem;
    color: var(--gray-600);
  }
  .arm__note {
    font-size: 0.875rem;
    color: var(--gray-500);
    margin-bottom: 1.5rem;
  }
  @media (max-width: 900px) {
    .arm {
      grid-template-columns: 1fr;
    }
  }
</style>
