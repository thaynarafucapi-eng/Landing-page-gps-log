---
/**
 * Visão geral das soluções. Para evitar repetição, os serviços que têm
 * seção própria (positivação, transporte/atuação e armazenagem) aparecem
 * aqui como resumo com link "Ver detalhes". Entregas é completo no card.
 */
import Photo from './Photo.astro';
import QuoteButton from './QuoteButton.astro';
import Icon from './Icon.astro';
import type { ServiceId } from '../config/site';
import { photos } from '../config/photos';

type Card = {
  id: ServiceId;
  title: string;
  description: string;
  photo: (typeof photos)[keyof typeof photos];
  icon: 'store' | 'truck' | 'route' | 'warehouse' | 'tools';
  detailsHref?: string;
  featured?: boolean;
};

/** Lista completa, conforme o slide "Nossos Serviços" da apresentação oficial. */
const allServices = [
  {
    group: 'Transporte',
    icon: 'truck',
    items: [
      'Carga expressa',
      'Carga aérea normal',
      'Carga aérea emergencial',
      'Cross docking',
      'Coleta e distribuição',
      'Transferência de material',
      'Logística reversa',
    ],
  },
  { group: 'Armazenagem', icon: 'warehouse', items: ['Armazenagem logística', 'Inventário', 'Montagem de kits'] },
  {
    group: 'Ponto de venda e promoções',
    icon: 'store',
    items: [
      'Positivação e negativação',
      'Ações em ponto de venda (PDV)',
      'Campanhas promocionais',
      'Ações de incentivo (prêmios)',
    ],
  },
  { group: 'Outros serviços', icon: 'layers', items: ['Serviço hot line', 'Transferência de notas fiscais'] },
] as const;

const cards: Card[] = [
  {
    id: 'positivacao',
    title: 'Positivação e negativação',
    description:
      'Coletamos, transportamos, montamos, instalamos e organizamos móveis, estruturas e materiais no ponto de venda. Depois, retiramos e devolvemos.',
    photo: photos.positivacao,
    icon: 'store',
    detailsHref: '#positivacao',
    featured: true,
  },
  {
    id: 'transporte',
    title: 'Transporte de cargas',
    description:
      'Cargas fracionadas e fechadas, transporte expresso de mercadorias e envios aéreos por companhias parceiras.',
    photo: photos.transporte,
    icon: 'truck',
    detailsHref: '#atuacao',
  },
  {
    id: 'entregas',
    title: 'Entregas, coletas e distribuição',
    description:
      'Coletas programadas, entregas de mercadorias e distribuição para Manaus e todos os municípios do interior do Amazonas, em operações pontuais ou recorrentes.',
    photo: photos.entregas,
    icon: 'route',
  },
  {
    id: 'armazenagem',
    title: 'Armazenagem de materiais',
    description:
      'Recebemos, armazenamos, controlamos entradas e saídas, separamos e expedimos seus materiais conforme a sua solicitação.',
    photo: photos.armazenagem,
    icon: 'warehouse',
    detailsHref: '#armazenagem',
  },
  {
    id: 'montagem',
    title: 'Montagem e instalação',
    description:
      'Montamos e instalamos móveis, estruturas e materiais onde você precisar: empresas, lojas, eventos e residências.',
    photo: photos.montagem,
    icon: 'tools',
  },
];
---

<section class="section section--muted" id="solucoes" aria-labelledby="solucoes-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Nossas soluções</p>
      <h2 id="solucoes-title">Do transporte à instalação no ponto de venda</h2>
      <p class="lead">
        Cinco frentes que funcionam sozinhas ou integradas, com uma única equipe responsável pela sua operação.
      </p>
    </div>

    <ul class="cards">
      {
        cards.map((c) => (
          <li class:list={['card', c.featured && 'card--featured']}>
            {c.featured && (
            <Photo
              src={c.photo.src}
              alt={c.photo.alt}
              sizes={c.featured ? '(max-width: 760px) 100vw, 540px' : '(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 560px'}
              widths={[400, 640, 900]}
              ratio="16 / 10"
              position={c.id === 'positivacao' ? 'center 40%' : 'center'}
              placeholderLabel={c.photo.pending}
              placeholderIcon={c.icon === 'warehouse' ? 'camera' : c.icon}
              class="card__media"
            />
            )}
            <div class="card__body">
              {c.featured && <span class="card__tag">Destaque</span>}
              <span class="card__icon">
                <Icon name={c.icon} size={22} />
              </span>
              <h3>{c.title}</h3>
              <p>{c.description}</p>
              <div class="card__actions">
                <QuoteButton service={c.id} size="sm" location={`card-${c.id}`} label="Solicitar orçamento" />
                {c.detailsHref && (
                  <a class="link-arrow" href={c.detailsHref}>
                    Ver detalhes
                  </a>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="all">
      <h3 class="all__title">Todos os nossos serviços</h3>
      <div class="all__grid">
        {
          allServices.map((g) => (
            <div class="all__group">
              <h4>
                <Icon name={g.icon} size={20} />
                {g.group}
              </h4>
              <ul class="checklist">
                {g.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="all__cta">
        <p>Precisa de um serviço que não está na lista? Fale com a nossa equipe.</p>
        <QuoteButton label="Falar com a equipe" variant="outline" size="sm" location="todos-servicos" />
      </div>
    </div>
  </div>
</section>

<style>
  .all {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }
  .all__title {
    font-size: 1.375rem;
    margin-bottom: 1.5rem;
  }
  .all__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem 2rem;
  }
  .all__group h4 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    padding-bottom: 0.6rem;
    margin-bottom: 0.9rem;
    border-bottom: 2px solid var(--red);
  }
  .all__group h4 :global(svg) {
    color: var(--red);
    flex: none;
  }
  .all__group li {
    font-size: 0.9375rem;
    margin-bottom: 0.45rem;
  }
  .all__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--gray-200);
  }
  .all__cta p {
    margin: 0;
    font-weight: 600;
    color: var(--ink);
  }
  @media (max-width: 1000px) {
    .all__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .all__grid {
      grid-template-columns: 1fr;
    }
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .card--featured {
    border-top: 4px solid var(--red);
  }
  .card :global(.card__media) {
    border-radius: 0;
  }
  /* cards sem foto: ícone entra no fluxo do texto */
  .card:not(.card--featured) .card__icon {
    position: static;
  }
  .card:not(.card--featured) h3 {
    margin-top: 1rem;
  }
  @media (min-width: 761px) {
    .card--featured {
      grid-column: 1 / -1;
      flex-direction: row;
    }
    .card--featured :global(.card__media) {
      flex: 0 0 46%;
      aspect-ratio: auto !important;
      min-height: 340px;
    }
    .card--featured :global(.card__media img) {
      position: absolute;
      inset: 0;
    }
    .card--featured .card__body {
      padding: 2rem 2.25rem;
    }
    .card--featured .card__icon {
      position: static;
    }
    .card--featured h3 {
      margin-top: 1rem;
    }
  }
  .card__body {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem 1.5rem 1.75rem;
  }
  .card__icon {
    position: absolute;
    top: -26px;
    left: 1.5rem;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--white);
    border-radius: var(--radius);
    border-bottom: 3px solid var(--red);
  }
  .card__tag {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--red);
    background: var(--red-50);
    padding: 0.2rem 0.55rem;
    border-radius: 3px;
  }
  .card h3 {
    margin-top: 1.5rem;
  }
  .card p {
    color: var(--gray-600);
    margin-bottom: 1.5rem;
  }
  .card__actions {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  @media (max-width: 760px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
