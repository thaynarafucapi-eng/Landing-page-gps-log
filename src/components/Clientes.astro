---
/**
 * Parceiros. Só é renderizada quando `clients.showClients` = true
 * em src/config/site.ts, e apenas após autorização de divulgação.
 */
import { clients } from '../config/site';
const list = clients.list;
---

{
  clients.showClients && list.length > 0 && (
    <section class="clientes" id="clientes" aria-labelledby="clientes-title">
      <div class="container">
        <h2 id="clientes-title" class="clientes__title">Empresas que trabalham com a GPSLOG</h2>
        <ul class="logos">
          {list.map((c) => (
            <li>
              {c.logo ? (
                <img src={c.logo} alt={c.name} loading="lazy" decoding="async" />
              ) : (
                <span>{c.name}</span>
              )}
            </li>
          ))}
        </ul>
        {clients.names.length > 0 && (
          <p class="names">
            Também atendemos: <strong>{clients.names.join(' · ')}</strong>
          </p>
        )}
      </div>
    </section>
  )
}

<style>
  .clientes {
    padding-block: clamp(2rem, 4vw, 2.75rem);
    border-bottom: 1px solid var(--gray-200);
  }
  .clientes__title {
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gray-500);
    margin-bottom: 1.25rem;
  }
  /* flex centralizado: com 7 logotipos, a última linha fica no meio */
  .logos {
    --cols: 7;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .logos li {
    flex: 0 0 calc((100% - (var(--cols) - 1) * 0.75rem) / var(--cols));
    display: grid;
    place-items: center;
    height: 80px;
    padding: 0.6rem 0.8rem;
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius);
  }
  .logos img {
    max-height: 52px;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .names {
    margin: 1rem auto 0;
    max-width: 820px;
    text-align: center;
    font-size: 0.875rem;
    color: var(--gray-600);
  }
  .names strong {
    color: var(--ink);
  }
  @media (max-width: 1000px) {
    .logos {
      --cols: 4;
    }
  }
  @media (max-width: 560px) {
    .logos {
      --cols: 3;
      gap: 0.5rem;
    }
    .logos li {
      height: 64px;
      padding: 0.4rem 0.5rem;
    }
    .logos img {
      max-height: 40px;
    }
  }
</style>
