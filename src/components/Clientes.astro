---
/**
 * Parceiros. Só é renderizada quando `clients.showClients` = true
 * em src/config/site.ts, e apenas após autorização de divulgação.
 */
import { clients } from '../config/site';
const list = clients.list;
---

{
  clients.showClients && list.length > 0 && (
    <section class="section clientes" id="clientes" aria-labelledby="clientes-title">
      <div class="container">
        <div class="section-head section-head--center">
          <p class="eyebrow">Nossos parceiros</p>
          <h2 id="clientes-title">Empresas que trabalham com a GPSLOG</h2>
        </div>
        <ul class="logos">
          {list.map((c) => (
            <li>
              {c.logo ? (
                <img src={c.logo} alt={c.name} loading="lazy" decoding="async" />
              ) : (
                <span>{c.name}</span>
              )}
            </li>
          ))}
        </ul>
        {clients.names.length > 0 && (
          <p class="names">
            Também atendemos: <strong>{clients.names.join(' · ')}</strong>
          </p>
        )}
      </div>
    </section>
  )
}

<style>
  .clientes {
    border-top: 1px solid var(--gray-200);
  }
  /* flex centralizado: com 7 logotipos, a última linha fica no meio */
  .logos {
    --cols: 4;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .logos li {
    flex: 0 0 calc((100% - (var(--cols) - 1) * 1rem) / var(--cols));
    display: grid;
    place-items: center;
    height: 120px;
    padding: 1.1rem 1.4rem;
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius);
    font-weight: 700;
    color: var(--gray-600);
    text-align: center;
  }
  .logos img {
    max-height: 76px;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .names {
    margin: 1.75rem auto 0;
    max-width: 760px;
    text-align: center;
    color: var(--gray-600);
  }
  .names strong {
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .logos {
      --cols: 3;
    }
  }
  @media (max-width: 560px) {
    .logos {
      --cols: 2;
    }
    .logos li {
      height: 96px;
      padding: 0.8rem;
    }
    .logos img {
      max-height: 60px;
    }
  }
</style>
