---
import Photo from './Photo.astro';
import QuoteButton from './QuoteButton.astro';
import Icon from './Icon.astro';
import { photos, pdvGallery } from '../config/photos';
import { Picture } from 'astro:assets';

const groups = [
  {
    icon: 'layout',
    title: 'Positivação',
    text: 'Coletamos os materiais da campanha, levamos até o estabelecimento, montamos, instalamos e organizamos o espaço, pronto para receber o público.',
  },
  {
    icon: 'undo',
    title: 'Negativação',
    text: 'Ao fim da ação, desmontamos, retiramos e levamos ao depósito ou destino indicado.',
  },
] as const;

const venues = ['Lojas', 'Shopping centers', 'Atacadões', 'Drogarias', 'Outros estabelecimentos comerciais'];
---

<section class="section section--dark posit" id="positivacao" aria-labelledby="posit-title">
  <div class="container">
    <div class="posit__top">
      <div class="posit__intro">
        <p class="eyebrow">Logística promocional em pontos de venda</p>
        <h2 id="posit-title">Positivação e negativação completas, do depósito ao ponto de venda</h2>
        <p class="lead">
          Mais que transportar: a GPSLOG executa a operação da sua campanha no ponto de venda, da coleta dos materiais
          à organização do espaço. Você contrata um fornecedor só.
        </p>
        <div class="posit__bottom">
          <div>
            <p class="posit__venues-label">Atendemos operações em:</p>
            <ul class="venues">
              {venues.map((v) => <li>{v}</li>)}
            </ul>
          </div>
          <div class="btn-row">
            <QuoteButton service="positivacao" label="Solicitar orçamento para minha operação" location="positivacao" />
          </div>
        </div>
      </div>

      <figure class="posit__photo">
        <Photo
          src={photos.positivacaoDestaque.src}
          alt={photos.positivacaoDestaque.alt}
          sizes="(max-width: 900px) 100vw, 420px"
          widths={[420, 640, 900]}
          ratio="3 / 4"
          position="center 35%"
          placeholderLabel={photos.positivacaoDestaque.pending}
          placeholderIcon="store"
        />
        <figcaption>Estrutura promocional montada e instalada pela equipe GPSLOG em ponto de venda.</figcaption>
      </figure>
    </div>

    <h3 class="posit__steps-title">Como funciona a operação</h3>
    <div class="flow">
      {
        groups.map((g) => (
          <div class="flow__group">
            <span class="flow__icon">
              <Icon name={g.icon} size={26} />
            </span>
            <h4 class="flow__title">{g.title}</h4>
            <p>{g.text}</p>
          </div>
        ))
      }
    </div>

    <h3 class="posit__steps-title">Operações realizadas pela GPSLOG</h3>
    <ul class="works">
      {
        pdvGallery.map((w) => (
          <li class:list={['works__item', w.wide && 'works__item--wide']}>
            <Picture
              src={w.src}
              alt={w.alt}
              formats={['avif', 'webp']}
              widths={w.wide ? [480, 800, w.src.width] : [300, w.src.width]}
              sizes={w.wide ? '(max-width: 760px) 100vw, 420px' : '(max-width: 760px) 50vw, 210px'}
              loading="lazy"
              decoding="async"
              quality={74}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .posit {
    position: relative;
    overflow: hidden;
  }
  .posit::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: var(--red);
  }
  .posit__top {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .posit__photo {
    margin: 0;
  }
  .posit__photo figcaption {
    font-size: 0.8125rem;
    color: #9aa0a8;
    margin-top: 0.6rem;
  }

  .posit__steps-title {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    margin-bottom: 1.5rem;
    font-size: 1.375rem;
  }
  .flow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .flow__group {
    background: var(--ink-800);
    border: 1px solid #2c2f34;
    border-top: 3px solid var(--red);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.5rem 1.75rem;
  }
  .flow__icon {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 1rem;
    color: var(--white);
    background: var(--ink);
    border: 1px solid #3a3e44;
    border-radius: var(--radius);
  }
  .flow__title {
    color: var(--white);
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .flow__group p {
    margin: 0;
    color: #aeb3ba;
    font-size: 1rem;
    line-height: 1.6;
  }

  .works {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: 300px;
    gap: 0.75rem;
  }
  .works__item {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--ink-800);
  }
  .works__item--wide {
    grid-column: span 2;
  }
  .works__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .works__item :global(picture) {
    display: contents;
  }
  @media (max-width: 900px) {
    .works {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 240px;
    }
  }

  .posit__bottom {
    margin-top: 2rem;
    display: grid;
    gap: 1.5rem;
  }
  .posit__venues-label {
    font-size: 0.875rem;
    color: #9aa0a8;
    margin-bottom: 0.6rem;
  }
  .venues {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .venues li {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--white);
    border: 1px solid #3a3e44;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
  }

  @media (max-width: 900px) {
    .posit__top {
      grid-template-columns: 1fr;
    }
    .posit__photo {
      max-width: 460px;
    }
    .flow {
      grid-template-columns: 1fr;
    }
  }
</style>
