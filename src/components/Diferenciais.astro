---
import Icon from './Icon.astro';
import { company } from '../config/site';

const items = [
  {
    icon: 'award',
    title: `${company.yearsInMarket} anos de experiência`,
    text: `Atuando desde ${company.foundingYear} em transporte e logística no Amazonas.`,
  },
  {
    icon: 'calendar',
    title: 'Compromisso com prazos',
    text: 'O prazo combinado no orçamento é tratado como prioridade em cada operação.',
  },
  {
    icon: 'bolt',
    title: 'Agilidade operacional',
    text: 'Estrutura enxuta para organizar coletas, entregas e instalações com rapidez.',
  },
  {
    icon: 'warehouse',
    title: 'Estrutura operacional',
    text: 'Galpão para armazenagem, frota própria e veículos parceiros conforme a demanda.',
  },
  {
    icon: 'headset',
    title: 'Atendimento personalizado',
    text: `Contato direto com a equipe e primeiro retorno em ${company.firstResponse}, em horário comercial.`,
  },
  {
    icon: 'layers',
    title: 'Soluções integradas',
    text: 'Transporte, armazenagem, distribuição e positivação com um único fornecedor.',
  },
] as const;
---

<section class="section" id="diferenciais" aria-labelledby="dif-title">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">Por que escolher a GPSLOG</p>
      <h2 id="dif-title">Experiência para organizar a sua operação do início ao fim</h2>
    </div>
    <ul class="difs">
      {
        items.map((d) => (
          <li class="dif">
            <span class="dif__icon">
              <Icon name={d.icon} size={26} />
            </span>
            <h3>{d.title}</h3>
            <p>{d.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .difs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--gray-200);
    border-left: 1px solid var(--gray-200);
  }
  .dif {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-right: 1px solid var(--gray-200);
    border-bottom: 1px solid var(--gray-200);
  }
  .dif__icon {
    display: inline-grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin-bottom: 1.1rem;
    color: var(--red);
    border: 2px solid var(--red);
    border-radius: var(--radius);
  }
  .dif h3 {
    font-size: 1.1875rem;
    margin-bottom: 0.4rem;
  }
  .dif p {
    margin: 0;
    color: var(--gray-600);
    font-size: 0.9875rem;
  }
  @media (max-width: 900px) {
    .difs {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .difs {
      grid-template-columns: 1fr;
    }
    .dif {
      display: grid;
      grid-template-columns: 54px 1fr;
      column-gap: 1rem;
    }
    .dif__icon {
      grid-row: span 2;
      margin: 0;
    }
  }
</style>
