---
import Icon from './Icon.astro';
import QuoteButton from './QuoteButton.astro';

const terrestre = [
  { title: 'Manaus e região metropolitana', text: 'Coletas, entregas, distribuição e transporte de cargas.' },
  { title: 'Interior do Amazonas', text: 'Transporte de cargas e mercadorias para os municípios do estado.' },
  { title: 'Roraima', text: 'Transporte rodoviário de cargas a partir de Manaus.' },
];

const modalidades = ['Carga fracionada', 'Carga fechada', 'Transporte expresso', 'Transporte de mercadorias'];
---

<section class="section" id="atuacao" aria-labelledby="atuacao-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Transporte e área de atuação</p>
      <h2 id="atuacao-title">Onde a GPSLOG leva a sua carga</h2>
      <p class="lead">
        Operação terrestre a partir de Manaus para a região metropolitana, o interior do Amazonas e Roraima, com a
        opção de envio aéreo por companhias parceiras.
      </p>
    </div>

    <div class="atuacao">
      <div class="modal modal--land">
        <header class="modal__head">
          <span class="modal__icon"><Icon name="truck" size={26} /></span>
          <div>
            <h3>Transporte terrestre</h3>
            <p>Operação própria com frota complementar de parceiros</p>
          </div>
        </header>
        <ul class="regions">
          {
            terrestre.map((r, i) => (
              <li>
                <span class="regions__n" aria-hidden="true">{i + 1}</span>
                <div>
                  <h4>{r.title}</h4>
                  <p>{r.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <ul class="tags" aria-label="Modalidades de transporte">
          {modalidades.map((m) => <li>{m}</li>)}
        </ul>
      </div>

      <div class="modal modal--air">
        <header class="modal__head">
          <span class="modal__icon"><Icon name="plane" size={26} /></span>
          <div>
            <h3>Transporte aéreo</h3>
            <p>Por meio de companhias aéreas parceiras</p>
          </div>
        </header>
        <p>
          Quando o prazo pede mais velocidade ou o destino exige, organizamos o envio da sua carga pelo modal aéreo,
          com o apoio de companhias parceiras.
        </p>
        <p class="modal__note">Consulte destinos, prazos e condições no orçamento.</p>
        <QuoteButton service="transporte" label="Consultar transporte" variant="outline" size="sm" location="atuacao" />
      </div>
    </div>
  </div>
</section>

<style>
  .atuacao {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 1.5rem;
  }
  .modal {
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--white);
  }
  .modal--air {
    background: var(--gray-100);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .modal--air p {
    color: var(--gray-600);
  }
  .modal__note {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink) !important;
    margin-top: auto;
  }
  .modal__head {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .modal__head h3 {
    margin: 0;
  }
  .modal__head p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--gray-500);
  }
  .modal__icon {
    flex: none;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    background: var(--red);
    color: var(--white);
    border-radius: var(--radius);
  }
  .modal--air .modal__icon {
    background: var(--ink);
  }
  .regions li {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--gray-200);
  }
  .regions h4 {
    font-size: 1.0625rem;
    margin-bottom: 0.2rem;
  }
  .regions p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--gray-600);
  }
  .regions__n {
    flex: none;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 2px solid var(--ink);
    font-weight: 800;
    font-size: 0.875rem;
    color: var(--ink);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--gray-200);
  }
  .tags li {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink);
    background: var(--gray-100);
    padding: 0.35rem 0.7rem;
    border-radius: 3px;
  }
  @media (max-width: 900px) {
    .atuacao {
      grid-template-columns: 1fr;
    }
  }
</style>
