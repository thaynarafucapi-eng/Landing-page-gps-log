---
/**
 * Formulário de orçamento em 2 etapas.
 * Não há backend: ao enviar, os dados são organizados em uma mensagem e o
 * WhatsApp comercial é aberto com o texto pronto. O envio só se conclui
 * quando o visitante toca em "Enviar" no WhatsApp — e o site diz isso.
 */
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { company, contact, services } from '../config/site';
import { stepTwoFields } from '../config/form';
---

<section class="section quote" id="orcamento" aria-labelledby="orcamento-title">
  <div class="container quote__grid">
    <div class="quote__aside">
      <p class="eyebrow">Solicitar orçamento</p>
      <h2 id="orcamento-title">Conte o que você precisa. Nós organizamos a operação.</h2>
      <p class="lead">
        Leva menos de um minuto. Ao concluir, a sua solicitação abre no nosso WhatsApp comercial já organizada para a
        equipe.
      </p>
      <ul class="quote__steps">
        <li><span>1</span> Preencha os dados básicos e escolha o serviço</li>
        <li><span>2</span> Informe os detalhes da operação, só o que souber</li>
        <li><span>3</span> Envie pelo WhatsApp e receba o retorno da equipe</li>
      </ul>
      <div class="quote__info">
        <p><Icon name="clock" size={18} /> <span>{company.hours.label}</span></p>
        <p>
          <Icon name="headset" size={18} />
          <span>Primeiro retorno em {company.firstResponse}, em horário comercial. O prazo da proposta depende da complexidade da operação.</span>
        </p>
      </div>
    </div>

    <div class="quote__card">
      <noscript>
        <p class="quote__noscript">
          Para usar o formulário, ative o JavaScript do navegador. Se preferir, fale direto com a nossa equipe:
        </p>
        <WhatsAppButton location="form-noscript" block />
      </noscript>

      <form class="qf" id="quote-form" novalidate data-quote-form>
        <div class="qf__progress" aria-hidden="true">
          <span class="qf__bar" data-progress></span>
        </div>
        <p class="qf__stepline" aria-live="polite" data-step-label>Etapa 1 de 2 · Dados básicos</p>

        <!-- ETAPA 1 -->
        <fieldset class="qf__step" data-step="1">
          <legend class="sr-only">Etapa 1: dados básicos</legend>

          <div class="field">
            <label for="qf-nome">Nome <span class="req" aria-hidden="true">*</span></label>
            <input id="qf-nome" name="nome" type="text" autocomplete="name" required minlength="2" />
            <p class="field__error" id="qf-nome-err" data-error-for="qf-nome"></p>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="qf-empresa">Empresa <span class="opt">(opcional)</span></label>
              <input id="qf-empresa" name="empresa" type="text" autocomplete="organization" />
            </div>
            <div class="field">
              <label for="qf-whatsapp">WhatsApp <span class="req" aria-hidden="true">*</span></label>
              <input
                id="qf-whatsapp"
                name="whatsapp"
                type="tel"
                inputmode="tel"
                autocomplete="tel-national"
                placeholder="(92) 90000-0000"
                required
                data-phone
              />
              <p class="field__error" id="qf-whatsapp-err" data-error-for="qf-whatsapp"></p>
            </div>
          </div>

          <div class="field" role="radiogroup" aria-labelledby="qf-servico-label" aria-describedby="qf-servico-err" data-service-group>
            <p class="label" id="qf-servico-label">Tipo de serviço <span class="req" aria-hidden="true">*</span></p>
            <div class="options">
              {
                services.map((s, i) => (
                  <label class="option">
                    <input type="radio" name="servico" value={s.id} required={i === 0} />
                    <span>{s.label}</span>
                  </label>
                ))
              }
            </div>
            <p class="field__error" id="qf-servico-err" data-error-for="servico"></p>
          </div>

          <button type="button" class="btn btn--block" data-next>
            Continuar <Icon name="arrow" />
          </button>
        </fieldset>

        <!-- ETAPA 2 -->
        <fieldset class="qf__step" data-step="2" hidden>
          <legend class="sr-only">Etapa 2: informações da operação</legend>

          {
            Object.entries(stepTwoFields).map(([serviceId, cfg]) => (
              <div class="qf__group" data-group={serviceId} hidden>
                <p class="qf__intro">{cfg.intro}</p>
                <div class="qf__fields">
                  {cfg.fields.map((f) => {
                    const id = `qf-${serviceId}-${f.name}`;
                    const fieldName = `${serviceId}__${f.name}`;
                    return (
                      <div class:list={['field', f.half && 'field--half']}>
                        <label for={id}>
                          {f.label}{' '}
                          {f.required ? (
                            <span class="req" aria-hidden="true">*</span>
                          ) : (
                            <span class="opt">(opcional)</span>
                          )}
                        </label>
                        {f.type === 'select' ? (
                          <select id={id} name={fieldName} required={f.required} disabled data-label={f.label}>
                            <option value="">Selecione</option>
                            {f.options?.map((o) => (
                              <option value={o}>{o}</option>
                            ))}
                          </select>
                        ) : f.type === 'textarea' ? (
                          <textarea id={id} name={fieldName} rows="3" required={f.required} placeholder={f.placeholder} disabled data-label={f.label} />
                        ) : (
                          <input
                            id={id}
                            name={fieldName}
                            type={f.type}
                            inputmode={f.type === 'number' ? 'numeric' : undefined}
                            min={f.type === 'number' ? '0' : undefined}
                            required={f.required}
                            placeholder={f.placeholder}
                            disabled
                            data-label={f.label}
                          />
                        )}
                        {f.hint && <p class="field__hint">{f.hint}</p>}
                        <p class="field__error" data-error-for={id} />
                      </div>
                    );
                  })}
                </div>
              </div>
            ))
          }

          <p class="qf__hours" data-hours-note></p>

          <div class="qf__actions">
            <button type="button" class="btn btn--outline" data-back>
              <Icon name="arrowLeft" /> Voltar
            </button>
            <button type="submit" class="btn btn--wa">
              <Icon name="whatsapp" /> Enviar pelo WhatsApp
            </button>
          </div>
          <p class="qf__legal">
            Seus dados são usados apenas para responder a esta solicitação.
            <a href="/privacidade/">Política de privacidade</a>.
          </p>
        </fieldset>

        <!-- RESULTADO -->
        <div class="qf__done" data-done hidden tabindex="-1">
          <span class="qf__done-icon"><Icon name="whatsapp" size={30} /></span>
          <h3>Falta só um toque</h3>
          <p>
            Abrimos o WhatsApp com a sua solicitação pronta. <strong>Para concluir, toque em “Enviar” na conversa.</strong>
            Nossa equipe responde em {company.firstResponse}, em horário comercial.
          </p>
          <div class="btn-row">
            <a class="btn btn--wa" href="#" target="_blank" rel="noopener" data-done-link>
              <Icon name="whatsapp" /> Abrir o WhatsApp novamente
            </a>
            <button type="button" class="btn btn--outline" data-restart>Nova solicitação</button>
          </div>
          <p class="qf__legal">WhatsApp comercial: {contact.whatsappDisplay}</p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .quote {
    background: var(--gray-100);
    border-top: 1px solid var(--gray-200);
  }
  .quote__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .quote__steps {
    margin: 1.75rem 0;
    display: grid;
    gap: 0.9rem;
  }
  .quote__steps li {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    font-weight: 600;
    color: var(--ink);
  }
  .quote__steps span {
    flex: none;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--white);
    font-weight: 800;
    font-size: 0.875rem;
    border-radius: var(--radius);
  }
  .quote__info {
    border-top: 1px solid var(--gray-300);
    padding-top: 1.25rem;
  }
  .quote__info p {
    display: flex;
    gap: 0.6rem;
    font-size: 0.9375rem;
    color: var(--gray-600);
    margin-bottom: 0.6rem;
  }
  .quote__info :global(svg) {
    flex: none;
    color: var(--red);
    margin-top: 3px;
  }
  .quote__card {
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-top: 4px solid var(--red);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: clamp(1.25rem, 3.5vw, 2.25rem);
  }
  .quote__noscript {
    margin-bottom: 1rem;
  }

  /* ---------- Formulário ---------- */
  .qf__progress {
    height: 4px;
    background: var(--gray-200);
    border-radius: 2px;
    overflow: hidden;
  }
  .qf__bar {
    display: block;
    height: 100%;
    width: 50%;
    background: var(--red);
    transition: width 0.3s ease;
  }
  .qf__stepline {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gray-500);
    margin: 0.75rem 0 1.25rem;
  }
  .qf__step {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .qf__intro {
    font-size: 0.9375rem;
    color: var(--gray-600);
    background: var(--gray-100);
    border-left: 3px solid var(--red);
    padding: 0.7rem 0.9rem;
  }
  .qf__fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
  }
  .qf__fields > .field {
    flex: 1 1 100%;
  }
  .qf__fields > .field--half {
    flex: 1 1 calc(50% - 0.5rem);
    min-width: 200px;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 1rem;
  }
  @media (max-width: 560px) {
    .field-row {
      grid-template-columns: 1fr;
    }
  }
  .field {
    margin-bottom: 1.1rem;
  }
  .field label,
  .field .label {
    display: block;
    font-weight: 650;
    font-size: 0.9375rem;
    color: var(--ink);
    margin: 0 0 0.4rem;
  }
  .req {
    color: var(--red);
  }
  .opt {
    font-weight: 400;
    color: var(--gray-500);
    font-size: 0.8125rem;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 50px;
    padding: 0.75rem 0.9rem;
    font: inherit;
    font-size: 1rem; /* evita zoom automático no iOS */
    color: var(--ink);
    background: var(--white);
    border: 1.5px solid var(--gray-300);
    border-radius: var(--radius);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  .field textarea {
    resize: vertical;
    min-height: 96px;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 3px rgb(17 17 17 / 0.12);
  }
  .field [aria-invalid='true'] {
    border-color: var(--red);
    box-shadow: 0 0 0 3px rgb(215 0 21 / 0.12);
  }
  .field__hint {
    font-size: 0.8125rem;
    color: var(--gray-500);
    margin: 0.3rem 0 0;
  }
  .field__error {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--red-700);
    margin: 0.35rem 0 0;
  }
  .field__error:empty {
    display: none;
  }

  .options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  @media (max-width: 560px) {
    .options {
      grid-template-columns: 1fr;
    }
  }
  .option {
    position: relative;
    display: flex !important;
    align-items: center;
    gap: 0.65rem;
    min-height: 52px;
    padding: 0.65rem 0.85rem;
    border: 1.5px solid var(--gray-300);
    border-radius: var(--radius);
    cursor: pointer;
    font-weight: 600 !important;
    font-size: 0.9375rem !important;
    line-height: 1.3;
    margin: 0 !important;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .option:hover {
    border-color: var(--ink);
  }
  .option input {
    width: 20px;
    height: 20px;
    min-height: 0;
    margin: 0;
    flex: none;
    accent-color: var(--red);
  }
  .option:has(input:checked) {
    border-color: var(--red);
    background: var(--red-50);
  }
  .option:has(input:focus-visible) {
    outline: 3px solid var(--red);
    outline-offset: 2px;
  }

  .qf__hours {
    font-size: 0.875rem;
    color: var(--gray-600);
  }
  .qf__hours:empty {
    display: none;
  }
  .qf__actions {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
  }
  .qf__legal {
    font-size: 0.8125rem;
    color: var(--gray-500);
    margin: 1rem 0 0;
  }
  .qf__done {
    text-align: left;
  }
  .qf__done:focus {
    outline: none;
  }
  .qf__done-icon {
    display: inline-grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--wa);
    color: var(--white);
    margin-bottom: 1rem;
  }

  @media (max-width: 900px) {
    .quote__grid {
      grid-template-columns: 1fr;
    }
    .quote__steps,
    .quote__info {
      display: none;
    }
  }
</style>
