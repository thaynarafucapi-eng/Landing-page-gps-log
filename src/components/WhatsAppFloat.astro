---
import Icon from './Icon.astro';
import { whatsappUrl } from '../config/site';
---

<a
  class="wa-float"
  href={whatsappUrl()}
  target="_blank"
  rel="noopener"
  data-wa-location="flutuante"
  aria-label="Conversar com a GPSLOG pelo WhatsApp (abre em nova aba)"
>
  <Icon name="whatsapp" size={30} />
  <span class="wa-float__label">Orçamento pelo WhatsApp</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    height: 60px;
    padding: 0 15px;
    border-radius: 999px;
    background: var(--wa);
    color: var(--white);
    text-decoration: none;
    font-weight: 700;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }
  .wa-float:hover {
    background: var(--wa-700);
    transform: translateY(-2px);
  }
  .wa-float__label {
    padding-right: 6px;
  }
  .wa-float.is-hidden {
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
  }
  .wa-float {
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      background-color 0.15s ease;
  }
  @media (max-width: 720px) {
    .wa-float {
      width: 60px;
      justify-content: center;
      padding: 0;
    }
    .wa-float__label {
      display: none;
    }
  }
</style>
