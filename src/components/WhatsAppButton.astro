---
/**
 * Botão/link de WhatsApp reutilizável.
 * `location` identifica a posição do clique nos eventos de conversão (GA4/Ads/Pixel).
 */
import Icon from './Icon.astro';
import { whatsappUrl } from '../config/site';

interface Props {
  label?: string;
  message?: string;
  location: string;
  variant?: 'wa' | 'outline' | 'outline-light';
  size?: 'sm' | 'md';
  block?: boolean;
  class?: string;
}

const {
  label = 'Conversar pelo WhatsApp',
  message,
  location,
  variant = 'wa',
  size = 'md',
  block = false,
  class: className,
} = Astro.props;

const classes = [
  'btn',
  variant === 'wa' ? 'btn--wa' : `btn--${variant}`,
  size === 'sm' && 'btn--sm',
  block && 'btn--block',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<a
  class={classes}
  href={whatsappUrl(message)}
  target="_blank"
  rel="noopener"
  data-wa-location={location}
>
  <Icon name="whatsapp" />
  <span>{label}</span>
  <span class="sr-only">(abre o WhatsApp em nova aba)</span>
</a>
