---
/**
 * Botão "Solicitar orçamento": abre o WhatsApp comercial com uma mensagem
 * que já cita o serviço, quando informado. Também é rastreado como clique
 * de WhatsApp (`data-wa-location`).
 */
import Icon from './Icon.astro';
import { contact, services, whatsappUrl, type ServiceId } from '../config/site';

interface Props {
  label?: string;
  service?: ServiceId;
  variant?: 'primary' | 'outline' | 'outline-light';
  size?: 'sm' | 'md';
  block?: boolean;
  location: string;
  class?: string;
}

const {
  label = 'Solicitar orçamento',
  service,
  variant = 'primary',
  size = 'md',
  block = false,
  location,
  class: className,
} = Astro.props;

const serviceLabel = services.find((s) => s.id === service)?.label;
const message = serviceLabel
  ? `Olá! Conheci a GPSLOG pelo site e gostaria de solicitar um orçamento de ${serviceLabel.toLowerCase()}.`
  : contact.whatsappDefaultMessage;

const classes = [
  'btn',
  variant !== 'primary' && `btn--${variant}`,
  size === 'sm' && 'btn--sm',
  block && 'btn--block',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<a class={classes} href={whatsappUrl(message)} target="_blank" rel="noopener" data-wa-location={location}>
  <Icon name="whatsapp" />
  <span>{label}</span>
  <span class="sr-only">(abre o WhatsApp em nova aba)</span>
</a>
