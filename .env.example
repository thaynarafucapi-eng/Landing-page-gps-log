# Copie para .env (local) ou cadastre no Netlify: Site configuration > Environment variables.
# Deixe vazio o que não for usar. Nenhum script de rastreamento é carregado sem ID.

# Domínio final (opcional; o Netlify já fornece a variável URL automaticamente)
SITE_URL=

# Google Tag Manager (ex.: GTM-XXXXXXX). Se usar o GTM, configure GA4/Ads/Pixel dentro dele
# e deixe os campos abaixo vazios para não duplicar disparos.
PUBLIC_GTM_ID=

# Google Analytics 4 direto, sem GTM (ex.: G-XXXXXXXXXX)
PUBLIC_GA4_ID=

# Google Ads direto, sem GTM (ex.: AW-XXXXXXXXX) e rótulos de conversão
PUBLIC_GADS_ID=
PUBLIC_GADS_LABEL_WHATSAPP=
PUBLIC_GADS_LABEL_FORM=

# Meta Pixel direto, sem GTM (somente números)
PUBLIC_META_PIXEL_ID=
